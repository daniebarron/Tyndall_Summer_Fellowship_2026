# 8:2 diPAP - full Opt+Freq restart with SCF convergence fixes
# Changes from original:
#   - SlowConv: enables damping and slower but more stable SCF convergence
#   - Increased MaxIter to 500 to give SCF more iterations
#   - Added level shifting to stabilise oscillating DIIS
#   - Reduced nprocs to 2 to avoid MPI stack overflow crash

! PBE0 def2-SVP def2/J RIJCOSX Opt Freq D3BJ TightSCF SlowConv

%pal
  nprocs 2
End

%maxcore 6000

%scf
  MaxIter  500
  Shift    Shift 0.3 ErrOff 0.1 end
End

%geom
  TolE    1e-4
  TolRMSG 1e-2
  TolMaxG 3e-2
  TolRMSD 1e-3
  TolMaxD 3e-3
End

